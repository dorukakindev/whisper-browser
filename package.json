{
  "name": "whisper-browser",
  "version": "0.9.0-beta.1",
  "description": "Local GPU-accelerated subtitle transcription, browser caption capture, and context-aware translation for Windows.",
  "main": "src/main.js",
  "scripts": {
    "build:browser-ass": "node tools/build-browser-ass.js",
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node tests/run-all.js",
    "test:electron-bridge": "electron tests/electron-browser-trusted-bridge.smoke.js --disable-gpu",
    "test:soak": "node tests/run-resource-soak.js",
    "audit:subtitle-pair": "node tools/audit-subtitle-pair.js",
    "compare:subtitle-translations": "node tools/compare-subtitle-translations.js",
    "audit:subtitle-corpus": "node tools/audit-subtitle-corpus.js",
    "audit:subtitle-golden": "node tools/audit-subtitle-golden.js",
    "audit:subtitle-external-sdh": "node tools/audit-subtitle-external-sdh.js"
  },
  "author": "dorukakindev and Whisper Browser contributors",
  "license": "MIT",
  "devDependencies": {
    "electron": "https://github.com/castlabs/electron-releases#v43.2.0+wvcus",
    "esbuild": "0.28.2",
    "imsc": "1.1.5",
    "mp4box": "2.4.1",
    "vtt.js": "0.13.0"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "2.18.2",
    "darkreader": "4.9.130",
    "hls.js": "^1.7.1",
    "jassub": "2.5.16",
    "mux.js": "6.3.0",
    "pdfjs-dist": "6.3.289"
  },
  "keywords": [
    "whisper",
    "faster-whisper",
    "subtitles",
    "altyazi",
    "srt",
    "electron",
    "transcription",
    "youtube",
    "cuda",
    "turkish"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dorukakindev/whisper-browser.git"
  },
  "bugs": {
    "url": "https://github.com/dorukakindev/whisper-browser/issues"
  },
  "homepage": "https://github.com/dorukakindev/whisper-browser#readme",
  "engines": {
    "node": ">=22.13.0"
  }
}
