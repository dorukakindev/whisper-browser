{
  "name": "whisper-altyazi",
  "version": "1.0.0",
  "description": "Yerel, GPU hizlandirmali altyazi cikarma uygulamasi (Electron + faster-whisper). Film ve belgesel icin ayarlanmis; dahili oynatici, ceviri ve senkron araclariyla.",
  "main": "src/main.js",
  "scripts": {
    "build:browser-ass": "node tools/build-browser-ass.js",
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node tests/run-all.js",
    "test:electron-bridge": "electron tests/electron-browser-trusted-bridge.smoke.js --disable-gpu",
    "test:soak": "node tests/run-resource-soak.js",
    "audit:subtitle-pair": "node tools/audit-subtitle-pair.js",
    "audit:subtitle-corpus": "node tools/audit-subtitle-corpus.js",
    "audit:subtitle-golden": "node tools/audit-subtitle-golden.js",
    "audit:subtitle-external-sdh": "node tools/audit-subtitle-external-sdh.js"
  },
  "author": "Whisper Altyazı",
  "license": "MIT",
  "devDependencies": {
    "electron": "https://github.com/castlabs/electron-releases#v43.2.0+wvcus",
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "2.18.2",
    "darkreader": "4.9.130",
    "hls.js": "^1.7.1",
    "jassub": "2.5.16",
    "pdfjs-dist": "6.3.289"
  },
  "keywords": [
    "whisper",
    "faster-whisper",
    "subtitles",
    "altyazi",
    "srt",
    "electron",
    "transcription",
    "youtube",
    "cuda",
    "turkish"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/androiandot/whisper-altyazi.git"
  },
  "bugs": {
    "url": "https://github.com/androiandot/whisper-altyazi/issues"
  },
  "homepage": "https://github.com/androiandot/whisper-altyazi#readme",
  "engines": {
    "node": ">=22.13.0"
  }
}
