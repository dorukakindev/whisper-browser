{
  "$schema": "http://json.schemastore.org/sarif-2.1.0",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "version": "1.10.3",
          "informationUri": "https://github.com/doyensec/electronegativity",
          "name": "Electronegativity",
          "fullName": "Electronegativity is a tool to identify misconfigurations and security anti-patterns in Electron applications",
          "rules": [
            {
              "id": "CSP_GLOBAL_CHECK",
              "fullDescription": {
                "text": "One or more CSP directives detected seems to be vulnerable"
              },
              "properties": {
                "category": "Security"
              },
              "helpUri": "https://github.com/doyensec/electronegativity/wiki/CSP_GLOBAL_CHECK",
              "help": {
                "text": "https://github.com/doyensec/electronegativity/wiki/CSP_GLOBAL_CHECK"
              }
            },
            {
              "id": "AUXCLICK_JS_CHECK",
              "fullDescription": {
                "text": "Limit navigation flows to untrusted origins. Middle-click may cause Electron to open a link within a new window"
              },
              "properties": {
                "category": "Security"
              },
              "helpUri": "https://github.com/doyensec/electronegativity/wiki/AUXCLICK_JS_CHECK",
              "help": {
                "text": "https://github.com/doyensec/electronegativity/wiki/AUXCLICK_JS_CHECK"
              }
            },
            {
              "id": "PRELOAD_JS_CHECK",
              "fullDescription": {
                "text": "Review the use of preload scripts"
              },
              "properties": {
                "category": "Security"
              },
              "helpUri": "https://github.com/doyensec/electronegativity/wiki/PRELOAD_JS_CHECK",
              "help": {
                "text": "https://github.com/doyensec/electronegativity/wiki/PRELOAD_JS_CHECK"
              }
            },
            {
              "id": "OPEN_EXTERNAL_JS_CHECK",
              "fullDescription": {
                "text": "Review the use of openExternal"
              },
              "properties": {
                "category": "Security"
              },
              "helpUri": "https://github.com/doyensec/electronegativity/wiki/OPEN_EXTERNAL_JS_CHECK",
              "help": {
                "text": "https://github.com/doyensec/electronegativity/wiki/OPEN_EXTERNAL_JS_CHECK"
              }
            },
            {
              "id": "CERTIFICATE_ERROR_EVENT_JS_CHECK",
              "fullDescription": {
                "text": "Do not allow insecure connections, by explicitly opting-out from TLS validation"
              },
              "properties": {
                "category": "Security"
              },
              "helpUri": "https://github.com/doyensec/electronegativity/wiki/CERTIFICATE_ERROR_EVENT_JS_CHECK",
              "help": {
                "text": "https://github.com/doyensec/electronegativity/wiki/CERTIFICATE_ERROR_EVENT_JS_CHECK"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CSP_GLOBAL_CHECK",
          "level": "note",
          "message": {
            "text": "One or more CSP directives detected seems to be vulnerable"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "renderer\\index.html"
                },
                "region": {
                  "startLine": 5,
                  "startColumn": 1,
                  "charLength": 271
                }
              }
            }
          ]
        },
        {
          "ruleId": "AUXCLICK_JS_CHECK",
          "level": "warning",
          "message": {
            "text": "Limit navigation flows to untrusted origins. Middle-click may cause Electron to open a link within a new window"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "main.js"
                },
                "region": {
                  "startLine": 6863,
                  "startColumn": 16,
                  "charLength": 32
                }
              }
            }
          ]
        },
        {
          "ruleId": "PRELOAD_JS_CHECK",
          "level": "note",
          "message": {
            "text": "Review the use of preload scripts"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "main.js"
                },
                "region": {
                  "startLine": 6886,
                  "startColumn": 7,
                  "charLength": 44
                }
              }
            }
          ]
        },
        {
          "ruleId": "OPEN_EXTERNAL_JS_CHECK",
          "level": "note",
          "message": {
            "text": "Review the use of openExternal"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "main.js"
                },
                "region": {
                  "startLine": 6962,
                  "startColumn": 36,
                  "charLength": 55
                }
              }
            }
          ]
        },
        {
          "ruleId": "CERTIFICATE_ERROR_EVENT_JS_CHECK",
          "level": "note",
          "message": {
            "text": "Do not allow insecure connections, by explicitly opting-out from TLS validation"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "main.js"
                },
                "region": {
                  "startLine": 6974,
                  "startColumn": 1,
                  "charLength": 89
                }
              }
            }
          ]
        },
        {
          "ruleId": "OPEN_EXTERNAL_JS_CHECK",
          "level": "note",
          "message": {
            "text": "Review the use of openExternal"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "main.js"
                },
                "region": {
                  "startLine": 8787,
                  "startColumn": 10,
                  "charLength": 31
                }
              }
            }
          ]
        },
        {
          "ruleId": "OPEN_EXTERNAL_JS_CHECK",
          "level": "note",
          "message": {
            "text": "Review the use of openExternal"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "renderer\\renderer.js"
                },
                "region": {
                  "startLine": 9834,
                  "startColumn": 3,
                  "charLength": 39
                }
              }
            }
          ]
        }
      ],
      "invocations": [
        {
          "workingDirectory": {
            "uri": "file:///D:\\Whisper Local\\src"
          },
          "executionSuccessful": true
        }
      ]
    }
  ]
}