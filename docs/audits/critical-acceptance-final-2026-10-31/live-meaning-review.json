          "id": 1,
          "times": "00:00:00,000 --> 00:00:16,000",
          "text": "Yirmi numuneden yalnızca yedisi geçti; diğer on üçünün hâlâ test edilmesi gerekiyor."
        },
        {
          "id": 2,
          "times": "00:00:26,000 --> 00:00:42,000",
          "text": "Her uyarı cihazın bozuk olduğu anlamına gelmez; bazı uyarılar yalnızca pil kontrolü ister."
        },
        {
          "id": 3,
          "times": "00:00:52,000 --> 00:01:08,000",
          "text": "Fırlatmayı sensör arızalandığı için erteledik, hava kötüleştiği için değil."
        },
        {
          "id": 4,
          "times": "00:01:18,000 --> 00:01:34,000",
          "text": "İkinci test sonucu doğrulamadıkça raporu yayımlamayın, ilk test geçmiş olsa bile."
        },
        {
          "id": 5,
          "times": "00:01:44,000 --> 00:02:00,000",
          "text": "Mürettebat şimdi ayrılabilir, ancak denetim bitene kadar motoru yeniden çalıştırmamalılar."
        },
        {
          "id": 6,
          "times": "00:02:10,000 --> 00:02:26,000",
          "text": "MARA: Deniz'e kendi arabamı değil, kardeşimin arabasını ödünç verdim."
        },
        {
          "id": 7,
          "times": "00:02:26,000 --> 00:02:42,000",
          "text": "DENİZ: Öyleyse onu sana değil, kardeşine iade etmeliyim."
        },
        {
          "id": 8,
          "times": "00:02:52,000 --> 00:03:08,000",
          "text": "Bakiye 12,50 dolarlık kârdan 3,25 dolarlık zarara düştü; bu 9,25 dolarlık değil, 15,75 dolarlık bir düşüştür."
        },
        {
          "id": 9,
          "times": "00:03:18,000 --> 00:03:34,000",
          "text": "Alarm basınç düştükten sonra çaldı, ama bu, alarmın çalmasına basınç düşüşünün neden olduğunu kanıtlamaz."
        }
      ]
