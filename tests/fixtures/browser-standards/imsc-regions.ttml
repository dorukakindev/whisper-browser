<?xml version="1.0" encoding="UTF-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:tts="http://www.w3.org/ns/ttml#styling">
  <head><layout><region xml:id="lower" tts:origin="10% 70%" tts:extent="80% 20%" tts:textAlign="center"/></layout></head>
  <body><div>
    <p region="lower" begin="1s" end="3s">Birinci <span>altyazı</span></p>
    <p region="lower" begin="3s" dur="2s">İkinci altyazı</p>
  </div></body>
